container_image = osdf:///ospool/ap40/data/adrian.fisher/mycontainer2.sif
executable = run_download_fits.sh

arguments = download_fits.py SDSS/partial_sdss.csv $(Process) $_CONDOR_SCRATCH_DIR/FITS_$(Process)

transfer_input_files = download_fits.py, timescape_functions.py, SDSS/partial_sdss.csv
should_transfer_files = YES
preserve_relative_paths = True
when_to_transfer_output = ON_EXIT

transfer_output_files = $_CONDOR_SCRATCH_DIR/FITS_$(Process)
transfer_output_remaps = "$_CONDOR_SCRATCH_DIR/FITS_$(Process) = osdf:///ospool/ap40/data/adrian.fisher/FITS_$(Process)"

log    = log_6/job_$(Cluster)_$(Process).log
output = log_6/job_$(Cluster)_$(Process).out
error  = log_6/job_$(Cluster)_$(Process).err

+JobDurationCategory = "Medium"
request_cpus = 1
request_memory = 10GB
request_disk = 30GB

queue 6